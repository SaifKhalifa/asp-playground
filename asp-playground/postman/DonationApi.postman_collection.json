{
  "info": {
    "name": "Donation Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5234"
    },
    {
      "key": "normalId",
      "value": ""
    },
    {
      "key": "anonId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Reports Healthy\", () => pm.expect(pm.response.json().status).to.eql(\"Healthy\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Create",
      "item": [
        {
          "name": "Create normal donation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"normalId\", pm.response.json().id);",
                  "const j = pm.response.json();",
                  "pm.test(\"Name visible\", () => pm.expect(j.donorName).to.eql(\"John Doe\"));",
                  "pm.test(\"Has createdAt\", () => pm.expect(j.createdAt).to.be.a(\"string\"));",
                  "pm.test(\"Location header set\", () => pm.response.to.have.header(\"Location\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/donations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "donations"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 50,\n  \"donorName\": \"John Doe\",\n  \"isAnonymous\": false\n}"
            }
          }
        },
        {
          "name": "Create anonymous donation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"anonId\", pm.response.json().id);",
                  "pm.test(\"Name hidden\", () => pm.expect(pm.response.json().donorName).to.be.null);",
                  "pm.test(\"Name not leaked in body\", () => pm.expect(pm.response.text()).to.not.include(\"Secret Donor\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/donations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "donations"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 75.5,\n  \"donorName\": \"Secret Donor\",\n  \"isAnonymous\": true\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Read",
      "item": [
        {
          "name": "Get all donations",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.test(\"Is paged response\", () => { pm.expect(page.items).to.be.an(\"array\"); pm.expect(page).to.include.keys(\"page\",\"pageSize\",\"totalCount\",\"totalPages\"); });",
                  "pm.test(\"Anonymous names never exposed\", () => { pm.expect(pm.response.text()).to.not.include(\"Secret Donor\"); page.items.filter(d => d.isAnonymous).forEach(d => pm.expect(d.donorName).to.be.null); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/donations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
