                  "const page = pm.response.json();",
                  "pm.test(\"One item, correct metadata\", () => { pm.expect(page.items).to.have.lengthOf(1); pm.expect(page.pageSize).to.eql(1); pm.expect(page.totalPages).to.eql(page.totalCount); });"
